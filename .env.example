# Copy to .env.local and fill in values from Supabase project settings
# Supabase project URL (e.g. https://abc123.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
# Supabase anon/public key (safe to expose in client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase service role key (SERVER ONLY — never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Database connection string for pg_dump (from Supabase Dashboard > Settings > Database)
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=your-database-url
# Cron job secret (used by Vercel cron to protect API routes)
CRON_SECRET=your-cron-secret
